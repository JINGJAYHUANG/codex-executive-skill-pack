{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JINGJAYHUANG/codex-executive-skill-pack/schemas/skills.schema.json",
  "title": "Codex Executive Skill Pack Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "pack",
    "layers",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pack": {
      "type": "object",
      "required": [
        "name",
        "version",
        "maturity",
        "runtime_status",
        "skill_count",
        "explicit_only_count",
        "routing_minimum_score"
      ],
      "properties": {
        "name": {
          "const": "codex-executive-skill-pack"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "maturity": {
          "const": "instruction-audited"
        },
        "runtime_status": {
          "const": "host-dependent"
        },
        "skill_count": {
          "const": 20
        },
        "explicit_only_count": {
          "const": 9
        },
        "routing_minimum_score": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "skill_count"
        ],
        "properties": {
          "id": {
            "enum": [
              "intelligence",
              "engineering-execution",
              "decision-learning",
              "orchestration-operations"
            ]
          },
          "label": {
            "type": "string"
          },
          "skill_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "anti_keywords",
          "avoid_when",
          "description",
          "display_name",
          "explicit_only",
          "failure_modes",
          "id",
          "inputs",
          "keywords",
          "layer",
          "maturity",
          "name",
          "negative_prompt",
          "negative_reason",
          "outputs",
          "permissions",
          "phrases",
          "positive_prompts",
          "purpose",
          "risk",
          "runtime_status",
          "use_when",
          "version",
          "workflow"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 3
          },
          "layer": {
            "enum": [
              "intelligence",
              "engineering-execution",
              "decision-learning",
              "orchestration-operations"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "description": {
            "type": "string",
            "minLength": 80
          },
          "explicit_only": {
            "type": "boolean"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "use_when": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "avoid_when": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "failure_modes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "phrases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "anti_keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "positive_prompts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "negative_prompt": {
            "type": "string"
          },
          "negative_reason": {
            "type": "string"
          },
          "maturity": {
            "const": "instruction-audited"
          },
          "runtime_status": {
            "const": "host-dependent"
          },
          "version": {
            "const": "0.1.0"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
